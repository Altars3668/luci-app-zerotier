#!/bin/sh

# Leftovers of earlier versions of this interface: the shell rpcd backend
# (it let the browser read the API token), pages that were merged or
# dropped, and the ztncui helpers
rm -f /usr/libexec/rpcd/zerotier-controller \
	/www/luci-static/resources/view/zerotier/config.js \
	/www/luci-static/resources/view/zerotier/interface.js \
	/www/luci-static/resources/view/zerotier/devices.js \
	/www/luci-static/resources/view/zerotier/network-controller.js \
	/usr/bin/ztncui-manager /usr/bin/ztncui-manager-enhanced /usr/bin/ztncui-helper \
	/etc/zerotier-controller.conf

# The moon's signing key lives in moon.json
[ -f /var/lib/zerotier-one/moon.json ] && chmod 600 /var/lib/zerotier-one/moon.json

# Stable host names: their configuration, and the check every minute
[ -f /etc/config/zerotier-phone-dns ] || touch /etc/config/zerotier-phone-dns
if ! grep -q 'zerotier-phone-dns' /etc/crontabs/root 2>/dev/null; then
	echo '* * * * * /usr/bin/zerotier-phone-dns >/dev/null 2>&1' >> /etc/crontabs/root
	/etc/init.d/cron restart >/dev/null 2>&1
fi

# Moons this router orbits: fetch a moon's current definition when there is
# no direct path to it, e.g. after the moon's address changed. Minutes 2,
# 7, ...: not together with the moon's own check (every 10 minutes), which
# restarts zerotier-one when it re-signs the moon
if ! grep -q 'zerotier-moon refresh' /etc/crontabs/root 2>/dev/null; then
	echo '2-59/5 * * * * /usr/bin/zerotier-moon refresh >/dev/null 2>&1' >> /etc/crontabs/root
	/etc/init.d/cron restart >/dev/null 2>&1
fi

rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null
/etc/init.d/rpcd reload >/dev/null 2>&1
exit 0
