#!/bin/sh
# ZeroTier Moon Management Script
# This script helps manage ZeroTier Moon nodes

ZT_HOME="/var/lib/zerotier-one"
ZT_CLI="/usr/bin/zerotier-cli"
ZT_IDTOOL="/usr/bin/zerotier-idtool"
MOON_CONFIG="/etc/zerotier-moon.conf"
FW_RULE_NAME="zerotier_moon"

# Check if ZeroTier is running
check_zerotier() {
    if ! pgrep zerotier-one > /dev/null; then
        echo "ERROR: ZeroTier is not running"
        exit 1
    fi
}

# Configure firewall rules for Moon
configure_firewall() {
    local action="$1"
    local port="${2:-9993}"
    
    case "$action" in
        "add"|"enable")
            # Check if rule already exists
            if uci -q get firewall.$FW_RULE_NAME > /dev/null 2>&1; then
                echo "Firewall rule already exists, updating..."
                uci set firewall.$FW_RULE_NAME.dest_port="$port"
            else
                echo "Adding firewall rule for port $port/UDP..."
                uci set firewall.$FW_RULE_NAME=rule
                uci set firewall.$FW_RULE_NAME.name="Allow-ZeroTier-Moon"
                uci set firewall.$FW_RULE_NAME.src="wan"
                uci set firewall.$FW_RULE_NAME.dest_port="$port"
                uci set firewall.$FW_RULE_NAME.proto="udp"
                uci set firewall.$FW_RULE_NAME.target="ACCEPT"
                uci set firewall.$FW_RULE_NAME.enabled="1"
            fi
            uci commit firewall
            /etc/init.d/firewall reload 2>/dev/null
            echo "Firewall rule added: $port/UDP from WAN"
            ;;
            
        "remove"|"disable")
            if uci -q get firewall.$FW_RULE_NAME > /dev/null 2>&1; then
                echo "Removing firewall rule..."
                uci delete firewall.$FW_RULE_NAME
                uci commit firewall
                /etc/init.d/firewall reload 2>/dev/null
                echo "Firewall rule removed"
            else
                echo "No firewall rule found"
            fi
            ;;
            
        "status")
            if uci -q get firewall.$FW_RULE_NAME > /dev/null 2>&1; then
                echo "=== ZeroTier Moon Firewall Rule ==="
                echo "Status: Enabled"
                echo "Name: $(uci -q get firewall.$FW_RULE_NAME.name)"
                echo "Source: $(uci -q get firewall.$FW_RULE_NAME.src)"
                echo "Port: $(uci -q get firewall.$FW_RULE_NAME.dest_port)/$(uci -q get firewall.$FW_RULE_NAME.proto)"
                echo "Target: $(uci -q get firewall.$FW_RULE_NAME.target)"
            else
                echo "No ZeroTier Moon firewall rule configured"
            fi
            ;;
            
        *)
            echo "Usage: $0 firewall {add|remove|status} [port]"
            echo "  add [port]    - Add firewall rule (default: 9993)"
            echo "  remove        - Remove firewall rule"
            echo "  status        - Show firewall rule status"
            return 1
            ;;
    esac
}

is_public_ip4() {
    echo "$1" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || return 1
    # RFC1918 / CGNAT / loopback / link-local are not publicly reachable
    case "$1" in
        10.*|127.*|169.254.*|192.168.*) return 1 ;;
        172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 1 ;;
        100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 1 ;;
    esac
    return 0
}

# Detect public IP address
detect_public_ip() {
    local ip=""

    # Fastest and most reliable: the WAN interface itself (PPPoE/direct)
    for iface_name in wan wan_4 pppoe-wan; do
        ip=$(ubus call network.interface.$iface_name status 2>/dev/null | \
            jsonfilter -qe '@["ipv4-address"][0].address')
        if is_public_ip4 "$ip"; then
            echo "$ip"
            return 0
        fi
    done

    # Fall back to external services (needed behind NAT)
    for service in "https://ifconfig.me" "https://ipinfo.io/ip" "https://api.ipify.org" "https://icanhazip.com"; do
        ip=$(curl -s --connect-timeout 5 "$service" 2>/dev/null | tr -d ' \r\n')
        if echo "$ip" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
            echo "$ip"
            return 0
        fi
    done

    return 1
}

# Resolve domain to IP
resolve_domain() {
    local domain="$1"
    
    # Check if it's already an IP
    if echo "$domain" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
        echo "$domain"
        return 0
    fi
    
    # Try nslookup
    local ip=$(nslookup "$domain" 2>/dev/null | grep -A1 "Name:" | grep "Address" | head -1 | awk '{print $2}')
    if [ -n "$ip" ]; then
        echo "$ip"
        return 0
    fi
    
    # Try host command
    ip=$(host "$domain" 2>/dev/null | grep "has address" | head -1 | awk '{print $NF}')
    if [ -n "$ip" ]; then
        echo "$ip"
        return 0
    fi
    
    # Try ping (busybox-safe extraction, no PCRE)
    ip=$(ping -c1 -W2 "$domain" 2>/dev/null | sed -n 's/.*(\([0-9.]*\)).*/\1/p' | head -1)
    if [ -n "$ip" ]; then
        echo "$ip"
        return 0
    fi

    return 1
}

# Create a moon configuration
create_moon() {
    local public_ip="$1"
    local public_port="${2:-9993}"
    local endpoints node_id

    if [ -z "$public_ip" ]; then
        echo "ERROR: Public IP address is required"
        exit 1
    fi
    if ! valid_endpoint "$public_ip" || ! valid_port "$public_port"; then
        echo "ERROR: Invalid endpoint or port"
        exit 1
    fi

    check_zerotier

    if [ ! -f "$ZT_HOME/identity.secret" ]; then
        echo "ERROR: ZeroTier identity not found"
        exit 1
    fi

    # stableEndpoints only take addresses: a domain is resolved here, and
    # "auto" announces the WAN addresses (IPv4 and, if any, IPv6)
    if [ "$public_ip" = "auto" ]; then
        endpoints=$(desired_endpoints auto "$public_port")
    else
        endpoints=$(resolve_domain "$public_ip") && endpoints="$endpoints/$public_port"
    fi
    if [ -z "$endpoints" ]; then
        echo "ERROR: Failed to resolve endpoint: $public_ip"
        exit 1
    fi

    regenerate_moon "$endpoints" || exit 1
    node_id=$(cut -d: -f1 "$ZT_HOME/identity.public")

    # Orbit our own moon. If it is loaded already, orbiting again does not
    # make zerotier-one read the new definition: only a restart does.
    if "$ZT_CLI" -j listmoons 2>/dev/null | jsonfilter -qe "@[@.id=\"000000$node_id\"].id" | grep -q .; then
        /etc/init.d/zerotier restart >/dev/null 2>&1
    else
        "$ZT_CLI" orbit "$node_id" "$node_id" >/dev/null 2>&1
    fi
    configure_firewall add "$public_port"

    echo "SUCCESS: Moon created successfully"
    echo "Moon ID: ${node_id}"
    echo "Endpoints: $(echo $endpoints)"
    echo ""
    echo "To join this moon from other nodes, run:"
    echo "  zerotier-cli orbit ${node_id} ${node_id}"
}

# Global IPv6 address of the WAN interface. It MUST come from the WAN
# (default-route) interface, not just be the first global v6: a LAN bridge
# usually also carries a delegated global prefix whose ::1 gateway address
# sorts first but is NOT reachable from outside.
detect_public_ip6() {
    local dev ip6
    dev=$(ip -4 route show default 2>/dev/null | sed -n 's/.*dev \([^ ]*\).*/\1/p' | head -1)
    if [ -n "$dev" ]; then
        ip6=$(ip -6 addr show dev "$dev" scope global 2>/dev/null | \
            sed -n 's|.*inet6 \([0-9a-f:]*\)/.*|\1|p' | grep -v '^f[cd]' | grep -v '::1$' | head -1)
    fi
    [ -z "$ip6" ] && ip6=$(ip -6 addr show scope global 2>/dev/null | \
        sed -n 's|.*inet6 \([0-9a-f:]*\)/.*|\1|p' | grep -v '^f[cd]' | grep -v '::1$' | head -1)
    [ -n "$ip6" ] && echo "$ip6"
}

# The endpoints the moon should announce for $1 (auto, IP or domain) and
# port $2, one "address/port" per line
desired_endpoints() {
    local endpoint="$1" port="$2" ip ip6

    case "$endpoint" in
        ""|auto) ip=$(detect_public_ip) ;;
        *) ip=$(resolve_domain "$endpoint") ;;
    esac
    echo "$ip" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || return 1

    echo "$ip/$port"
    ip6=$(detect_public_ip6)
    [ -n "$ip6" ] && echo "$ip6/$port"
    return 0
}

# The endpoints our moon announces now, one per line: as zerotier-one has
# it loaded - not as moon.json says, which is only the input of a signing
# that may have failed - or from moon.json while zerotier-one is down
current_endpoints() {
    local self
    self=$("$ZT_CLI" -j info 2>/dev/null | jsonfilter -qe '@.address')
    if [ -n "$self" ]; then
        "$ZT_CLI" -j listmoons 2>/dev/null | \
            jsonfilter -qe "@[@.id=\"000000$self\"].roots[0].stableEndpoints[*]"
        return 0
    fi
    jsonfilter -i "$ZT_HOME/moon.json" -e '@.roots[0].stableEndpoints[*]' 2>/dev/null
}

# Point moon.json at the endpoints in $1 (one per line). The file is
# rewritten as JSON: a line-based edit silently missed an endpoint list
# spread over several lines, and every later check then took the stale
# endpoints for current ones.
set_endpoints() {
    # moon.json holds the signing key: the new file must never be readable
    # by others, not even for a moment
    if ! (umask 077; ucode -e '
        import { readfile, writefile, rename } from "fs";
        const f = ARGV[0];
        const moon = json(readfile(f));
        moon.roots[0].stableEndpoints = filter(split(trim(ARGV[1]), "\n"), (e) => length(e) > 0);
        if (!writefile(f + ".new", sprintf("%.2J\n", moon)) || !rename(f + ".new", f))
            exit(1);
    ' "$ZT_HOME/moon.json" "$1"); then
        rm -f "$ZT_HOME/moon.json.new"
        return 1
    fi
}

# Sign the moon anew with the endpoints in $1. The signing key in moon.json
# is kept: nodes that orbit the moon verify every update against the
# original updatesMustBeSignedBy, so a new key would lose them all.
regenerate_moon() {
    local endpoints="$1" node_id moon_file

    if [ ! -f "$ZT_HOME/identity.public" ]; then
        "$ZT_IDTOOL" getpublic "$ZT_HOME/identity.secret" > "$ZT_HOME/identity.public"
    fi
    node_id=$(cut -d: -f1 "$ZT_HOME/identity.public")
    cd "$ZT_HOME" || return 1

    # moon.json holds the moon's signing key: root only
    if [ ! -s moon.json ] || ! grep -q 'signingKey_SECRET' moon.json; then
        echo "No reusable moon.json, initializing a fresh one..."
        (umask 077; "$ZT_IDTOOL" initmoon identity.public > moon.json 2>/dev/null)
    fi
    chmod 600 moon.json
    if ! set_endpoints "$endpoints"; then
        echo "ERROR: Failed to write moon.json"
        return 1
    fi
    chmod 600 moon.json

    # Only OUR OWN moon file: moons.d also holds the moons of other nodes
    # we orbit, and they must survive an endpoint update
    moon_file="000000${node_id}.moon"
    rm -f "$moon_file"
    if ! "$ZT_IDTOOL" genmoon moon.json >/dev/null 2>&1 || [ ! -f "$moon_file" ]; then
        echo "ERROR: Failed to generate moon"
        return 1
    fi
    mkdir -p moons.d
    mv "$moon_file" moons.d/
    return 0
}

# Join a moon
join_moon() {
    local moon_id="$1"
    
    if [ -z "$moon_id" ]; then
        echo "ERROR: Moon ID is required"
        exit 1
    fi
    
    check_zerotier
    
    if "$ZT_CLI" orbit "$moon_id" "$moon_id"; then
        echo "SUCCESS: Joined moon ${moon_id}"
    else
        echo "ERROR: Failed to join moon ${moon_id}"
        exit 1
    fi
}

# Leave a moon
leave_moon() {
    local moon_id="$1"
    
    if [ -z "$moon_id" ]; then
        echo "ERROR: Moon ID is required"
        exit 1
    fi
    
    check_zerotier
    
    if "$ZT_CLI" deorbit "$moon_id"; then
        echo "SUCCESS: Left moon ${moon_id}"
    else
        echo "ERROR: Failed to leave moon ${moon_id}"
        exit 1
    fi
}

# List moons
list_moons() {
    check_zerotier
    
    "$ZT_CLI" listmoons
}

# Get node info
get_info() {
    check_zerotier
    
    "$ZT_CLI" info
}

# Values are later read back with conf_get — never sourced — but reject
# anything that is not a plain IP/hostname/port up front anyway.
valid_endpoint() {
    echo "$1" | grep -qE '^(auto|[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+|[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?)$'
}

valid_port() {
    echo "$1" | grep -qE '^[0-9]{1,5}$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# Read one KEY=value from the config without sourcing it as shell
conf_get() {
    sed -n "s/^$1=//p" "$MOON_CONFIG" 2>/dev/null | head -1
}

CRON_FILE="/etc/crontabs/root"
CRON_LINE="*/10 * * * * /usr/bin/zerotier-moon update >/dev/null 2>&1"

# Keep the moon endpoint fresh without anyone watching a browser tab:
# a cron entry re-checks every 10 minutes (hotplug covers WAN bounces).
register_cron() {
    grep -qF "zerotier-moon update" "$CRON_FILE" 2>/dev/null && return
    echo "$CRON_LINE" >> "$CRON_FILE"
    /etc/init.d/cron restart >/dev/null 2>&1
    echo "Registered periodic IP check (every 10 min via cron)"
}

unregister_cron() {
    [ -f "$CRON_FILE" ] || return
    grep -qF "zerotier-moon update" "$CRON_FILE" || return
    sed -i '\|zerotier-moon update|d' "$CRON_FILE"
    /etc/init.d/cron restart >/dev/null 2>&1
}

# Configure dynamic IP/domain for moon
configure_dynamic() {
    local action="$1"
    local endpoint="$2"
    local port="${3:-9993}"

    case "$action" in
        "enable")
            # "auto" follows the WAN address; a fixed IP would defeat the
            # point of dynamic updates
            [ -n "$endpoint" ] || endpoint=auto

            if ! valid_endpoint "$endpoint"; then
                echo "ERROR: Invalid endpoint: $endpoint"
                return 1
            fi
            if ! valid_port "$port"; then
                echo "ERROR: Invalid port: $port"
                return 1
            fi

            # Save configuration
            cat > "$MOON_CONFIG" << EOF
# ZeroTier Moon Dynamic IP Configuration
ENABLED=1
ENDPOINT=$endpoint
PORT=$port
LAST_IP=
LAST_UPDATE=$(date +%s)
EOF
            echo "Dynamic IP monitoring enabled"
            echo "Endpoint: $endpoint:$port"

            # Auto-configure firewall
            configure_firewall add "$port"

            register_cron

            # Create initial moon
            update_moon_ip
            ;;

        "disable")
            if [ -f "$MOON_CONFIG" ]; then
                sed -i 's/ENABLED=1/ENABLED=0/' "$MOON_CONFIG"
                unregister_cron
                echo "Dynamic IP monitoring disabled"
            else
                echo "Not configured"
            fi
            ;;
            
        "status")
            if [ -f "$MOON_CONFIG" ]; then
                echo "=== Moon Dynamic IP Configuration ==="
                cat "$MOON_CONFIG"
                echo ""
                echo "=== Current Moon Status ==="
                list_moons 2>/dev/null || echo "ZeroTier not running"
            else
                echo "Dynamic IP not configured"
            fi
            ;;
            
        "update"|"check")
            update_moon_ip
            ;;
            
        *)
            echo "Usage: $0 dynamic {enable|disable|status|update} [endpoint] [port]"
            echo "  enable [domain/ip] [port] - Enable with domain or auto-detect IP"
            echo "  disable                   - Disable dynamic IP monitoring"
            echo "  status                    - Show configuration status"
            echo "  update                    - Force update moon with current IP"
            return 1
            ;;
    esac
}

# Update moon with current IP (called by cron, hotplug or manually)
update_moon_ip() {
    if [ ! -f "$MOON_CONFIG" ]; then
        echo "ERROR: Not configured. Run: $0 dynamic enable [endpoint] [port]"
        return 1
    fi

    # Values are read individually (conf_get), never sourced: a hostile
    # ENDPOINT line must not become executable shell.
    local enabled endpoint port desired current
    enabled=$(conf_get ENABLED)
    endpoint=$(conf_get ENDPOINT)
    port=$(conf_get PORT)
    valid_port "$port" || port=9993

    if [ "$enabled" != "1" ]; then
        echo "Dynamic IP monitoring is disabled"
        return 0
    fi

    desired=$(desired_endpoints "$endpoint" "$port")
    if [ -z "$desired" ]; then
        echo "ERROR: Failed to resolve endpoint: $endpoint"
        return 1
    fi

    # Compare with what the moon announces, not with the address seen last:
    # an update that failed half-way must not look done on the next run
    current=$(current_endpoints)
    if [ "$(echo "$desired" | sort)" = "$(echo "$current" | sort)" ]; then
        echo "Endpoints unchanged: $(echo $desired)"
        return 0
    fi

    echo "Endpoints: $(echo ${current:-<none>}) -> $(echo $desired)"
    check_zerotier
    regenerate_moon "$desired" || return 1

    sed -i "s/^LAST_IP=.*/LAST_IP=$(echo "$desired" | head -1 | cut -d/ -f1)/" "$MOON_CONFIG"
    sed -i "s/^LAST_UPDATE=.*/LAST_UPDATE=$(date +%s)/" "$MOON_CONFIG"

    # Restart so the daemon loads the new moon definition, then pushes the
    # new world revision out to connected peers
    /etc/init.d/zerotier restart >/dev/null 2>&1
    logger -t zerotier-moon "Moon endpoints updated: $(echo $desired)"
    echo "SUCCESS: Moon updated: $(echo $desired)"
}

# Main function
case "$1" in
    "create")
        create_moon "$2" "$3"
        ;;
    "join")
        join_moon "$2"
        ;;
    "leave")
        leave_moon "$2"
        ;;
    "endpoints")
        # What the moon should announce now (used by the web interface): with
        # dynamic updates, what they follow; otherwise the WAN addresses, on
        # the port the moon uses now
        if [ "$(conf_get ENABLED)" = "1" ]; then
            desired_endpoints "$(conf_get ENDPOINT)" "$(conf_get PORT | grep . || echo 9993)"
        else
            port=$(current_endpoints | head -1 | sed -n 's|.*/\([0-9]*\)$|\1|p')
            desired_endpoints auto "${port:-9993}"
        fi
        ;;
    "current")
        current_endpoints
        ;;
    "list")
        list_moons
        ;;
    "info")
        get_info
        ;;
    "dynamic")
        configure_dynamic "$2" "$3" "$4"
        ;;
    "update")
        update_moon_ip
        ;;
    "firewall")
        configure_firewall "$2" "$3"
        ;;
    *)
        echo "Usage: $0 {create|join|leave|list|info|dynamic|update|endpoints|current|firewall}"
        echo ""
        echo "Commands:"
        echo "  create <ip/domain|auto> [port]  - Create a moon node"
        echo "  join <moon_id>                  - Join a moon network"
        echo "  leave <moon_id>                 - Leave a moon network"
        echo "  list                            - List connected moons"
        echo "  info                            - Show node information"
        echo "  dynamic {enable|disable|status|update} [endpoint] [port]"
        echo "                                  - Configure dynamic IP/domain"
        echo "  update                          - Update moon with current IP"
        echo "  endpoints                       - Endpoints the moon should announce"
        echo "  current                         - Endpoints the moon announces now"
        echo "  firewall {add|remove|status} [port]"
        echo "                                  - Manage firewall rules"
        exit 1
        ;;
esac