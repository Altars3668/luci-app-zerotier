#!/bin/sh
# ZeroTier Moon Management Script
# This script helps manage ZeroTier Moon nodes

ZT_HOME="/var/lib/zerotier-one"
ZT_CLI="/usr/bin/zerotier-cli"
ZT_IDTOOL="/usr/bin/zerotier-idtool"
MOON_CONFIG="/etc/zerotier-moon.conf"
FW_RULE_NAME="zerotier_moon"

# Check if ZeroTier is running
check_zerotier() {
    if ! pgrep zerotier-one > /dev/null; then
        echo "ERROR: ZeroTier is not running"
        exit 1
    fi
}

# Configure firewall rules for Moon
configure_firewall() {
    local action="$1"
    local port="${2:-9993}"
    
    case "$action" in
        "add"|"enable")
            # Check if rule already exists
            if uci -q get firewall.$FW_RULE_NAME > /dev/null 2>&1; then
                echo "Firewall rule already exists, updating..."
                uci set firewall.$FW_RULE_NAME.dest_port="$port"
            else
                echo "Adding firewall rule for port $port/UDP..."
                uci set firewall.$FW_RULE_NAME=rule
                uci set firewall.$FW_RULE_NAME.name="Allow-ZeroTier-Moon"
                uci set firewall.$FW_RULE_NAME.src="wan"
                uci set firewall.$FW_RULE_NAME.dest_port="$port"
                uci set firewall.$FW_RULE_NAME.proto="udp"
                uci set firewall.$FW_RULE_NAME.target="ACCEPT"
                uci set firewall.$FW_RULE_NAME.enabled="1"
            fi
            uci commit firewall
            /etc/init.d/firewall reload 2>/dev/null
            echo "Firewall rule added: $port/UDP from WAN"
            ;;
            
        "remove"|"disable")
            if uci -q get firewall.$FW_RULE_NAME > /dev/null 2>&1; then
                echo "Removing firewall rule..."
                uci delete firewall.$FW_RULE_NAME
                uci commit firewall
                /etc/init.d/firewall reload 2>/dev/null
                echo "Firewall rule removed"
            else
                echo "No firewall rule found"
            fi
            ;;
            
        "status")
            if uci -q get firewall.$FW_RULE_NAME > /dev/null 2>&1; then
                echo "=== ZeroTier Moon Firewall Rule ==="
                echo "Status: Enabled"
                echo "Name: $(uci -q get firewall.$FW_RULE_NAME.name)"
                echo "Source: $(uci -q get firewall.$FW_RULE_NAME.src)"
                echo "Port: $(uci -q get firewall.$FW_RULE_NAME.dest_port)/$(uci -q get firewall.$FW_RULE_NAME.proto)"
                echo "Target: $(uci -q get firewall.$FW_RULE_NAME.target)"
            else
                echo "No ZeroTier Moon firewall rule configured"
            fi
            ;;
            
        *)
            echo "Usage: $0 firewall {add|remove|status} [port]"
            echo "  add [port]    - Add firewall rule (default: 9993)"
            echo "  remove        - Remove firewall rule"
            echo "  status        - Show firewall rule status"
            return 1
            ;;
    esac
}

is_public_ip4() {
    echo "$1" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || return 1
    # RFC1918 / CGNAT / loopback / link-local are not publicly reachable
    case "$1" in
        10.*|127.*|169.254.*|192.168.*) return 1 ;;
        172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 1 ;;
        100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 1 ;;
    esac
    return 0
}

# Detect public IP address
detect_public_ip() {
    local ip=""

    # Fastest and most reliable: the WAN interface itself (PPPoE/direct)
    for iface_name in wan wan_4 pppoe-wan; do
        ip=$(ubus call network.interface.$iface_name status 2>/dev/null | \
            jsonfilter -qe '@["ipv4-address"][0].address')
        if is_public_ip4 "$ip"; then
            echo "$ip"
            return 0
        fi
    done

    # Fall back to external services (needed behind NAT)
    for service in "https://ifconfig.me" "https://ipinfo.io/ip" "https://api.ipify.org" "https://icanhazip.com"; do
        ip=$(curl -s --connect-timeout 5 "$service" 2>/dev/null | tr -d ' \r\n')
        if echo "$ip" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
            echo "$ip"
            return 0
        fi
    done

    return 1
}

# Resolve domain to IP
resolve_domain() {
    local domain="$1"
    
    # Check if it's already an IP
    if echo "$domain" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
        echo "$domain"
        return 0
    fi
    
    # Try nslookup
    local ip=$(nslookup "$domain" 2>/dev/null | grep -A1 "Name:" | grep "Address" | head -1 | awk '{print $2}')
    if [ -n "$ip" ]; then
        echo "$ip"
        return 0
    fi
    
    # Try host command
    ip=$(host "$domain" 2>/dev/null | grep "has address" | head -1 | awk '{print $NF}')
    if [ -n "$ip" ]; then
        echo "$ip"
        return 0
    fi
    
    # Try ping (busybox-safe extraction, no PCRE)
    ip=$(ping -c1 -W2 "$domain" 2>/dev/null | sed -n 's/.*(\([0-9.]*\)).*/\1/p' | head -1)
    if [ -n "$ip" ]; then
        echo "$ip"
        return 0
    fi

    return 1
}

# Create a moon configuration
create_moon() {
    local public_ip="$1"
    local public_port="${2:-9993}"
    
    if [ -z "$public_ip" ]; then
        echo "ERROR: Public IP address is required"
        exit 1
    fi
    
    check_zerotier
    
    # Get node identity - generate public if not exists
    if [ ! -f "$ZT_HOME/identity.secret" ]; then
        echo "ERROR: ZeroTier identity not found"
        exit 1
    fi
    
    # Generate identity.public from identity.secret if needed
    if [ ! -f "$ZT_HOME/identity.public" ]; then
        "$ZT_IDTOOL" getpublic "$ZT_HOME/identity.secret" > "$ZT_HOME/identity.public"
    fi
    
    local node_id=$(cat "$ZT_HOME/identity.public" | cut -d':' -f1)
    local moon_json="$ZT_HOME/moon.json"
    
    # Work in ZT_HOME directory
    cd "$ZT_HOME"

    # Step 1: Generate initial moon.json using initmoon — but only if we
    # don't already have one with its signing key. Re-keying an existing
    # moon would break every node that already orbits it (updates are
    # verified against the original updatesMustBeSignedBy).
    if [ ! -s "$moon_json" ] || ! grep -q 'signingKey_SECRET' "$moon_json"; then
        "$ZT_IDTOOL" initmoon "$ZT_HOME/identity.public" > "$moon_json" 2>/dev/null
    fi
    if [ ! -f "$moon_json" ] || [ ! -s "$moon_json" ]; then
        echo "ERROR: Failed to initialize moon configuration"
        exit 1
    fi

    # Step 2: Set stableEndpoints in moon.json (works for both a fresh
    # "[]" and a previous non-empty list)
    sed -i "s|\"stableEndpoints\": \[[^]]*\]|\"stableEndpoints\": [\"${public_ip}/${public_port}\"]|" "$moon_json"
    
    echo "=== Moon configuration ==="
    cat "$moon_json"
    echo ""
    
    # Step 3: Generate moon file using genmoon (creates file in current directory)
    if "$ZT_IDTOOL" genmoon "$moon_json" 2>/dev/null; then
        local moon_file=$(ls -1 000000*.moon 2>/dev/null | head -1)
        
        if [ -n "$moon_file" ] && [ -f "$moon_file" ]; then
            # Create moons.d directory if it doesn't exist
            mkdir -p "$ZT_HOME/moons.d"
            
            # Move moon file to moons.d
            mv "$moon_file" "$ZT_HOME/moons.d/"
            
            echo "SUCCESS: Moon created successfully"
            echo "Moon ID: ${node_id}"
            echo "Moon file: $ZT_HOME/moons.d/$moon_file"
            echo ""
            echo "To join this moon from other nodes, run:"
            echo "  zerotier-cli orbit ${node_id} ${node_id}"
            
            # Auto-join own moon
            "$ZT_CLI" orbit "${node_id}" "${node_id}" 2>/dev/null
            
            # Auto-configure firewall
            configure_firewall add "$public_port"
        else
            echo "ERROR: Moon file not generated"
            exit 1
        fi
    else
        echo "ERROR: Failed to generate moon file"
        exit 1
    fi
}

# Join a moon
join_moon() {
    local moon_id="$1"
    
    if [ -z "$moon_id" ]; then
        echo "ERROR: Moon ID is required"
        exit 1
    fi
    
    check_zerotier
    
    if "$ZT_CLI" orbit "$moon_id" "$moon_id"; then
        echo "SUCCESS: Joined moon ${moon_id}"
    else
        echo "ERROR: Failed to join moon ${moon_id}"
        exit 1
    fi
}

# Leave a moon
leave_moon() {
    local moon_id="$1"
    
    if [ -z "$moon_id" ]; then
        echo "ERROR: Moon ID is required"
        exit 1
    fi
    
    check_zerotier
    
    if "$ZT_CLI" deorbit "$moon_id"; then
        echo "SUCCESS: Left moon ${moon_id}"
    else
        echo "ERROR: Failed to leave moon ${moon_id}"
        exit 1
    fi
}

# List moons
list_moons() {
    check_zerotier
    
    "$ZT_CLI" listmoons
}

# Get node info
get_info() {
    check_zerotier
    
    "$ZT_CLI" info
}

# Values are later read back with conf_get — never sourced — but reject
# anything that is not a plain IP/hostname/port up front anyway.
valid_endpoint() {
    echo "$1" | grep -qE '^(auto|[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+|[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?)$'
}

valid_port() {
    echo "$1" | grep -qE '^[0-9]{1,5}$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# Read one KEY=value from the config without sourcing it as shell
conf_get() {
    sed -n "s/^$1=//p" "$MOON_CONFIG" 2>/dev/null | head -1
}

CRON_FILE="/etc/crontabs/root"
CRON_LINE="*/10 * * * * /usr/bin/zerotier-moon update >/dev/null 2>&1"

# Keep the moon endpoint fresh without anyone watching a browser tab:
# a cron entry re-checks every 10 minutes (hotplug covers WAN bounces).
register_cron() {
    grep -qF "zerotier-moon update" "$CRON_FILE" 2>/dev/null && return
    echo "$CRON_LINE" >> "$CRON_FILE"
    /etc/init.d/cron restart >/dev/null 2>&1
    echo "Registered periodic IP check (every 10 min via cron)"
}

unregister_cron() {
    [ -f "$CRON_FILE" ] || return
    grep -qF "zerotier-moon update" "$CRON_FILE" || return
    sed -i '\|zerotier-moon update|d' "$CRON_FILE"
    /etc/init.d/cron restart >/dev/null 2>&1
}

# Configure dynamic IP/domain for moon
configure_dynamic() {
    local action="$1"
    local endpoint="$2"
    local port="${3:-9993}"

    case "$action" in
        "enable")
            if [ -z "$endpoint" ]; then
                echo "Auto-detecting public IP..."
                endpoint=$(detect_public_ip)
                if [ $? -ne 0 ] || [ -z "$endpoint" ]; then
                    echo "ERROR: Failed to detect public IP"
                    return 1
                fi
            fi

            if ! valid_endpoint "$endpoint"; then
                echo "ERROR: Invalid endpoint: $endpoint"
                return 1
            fi
            if ! valid_port "$port"; then
                echo "ERROR: Invalid port: $port"
                return 1
            fi

            # Save configuration
            cat > "$MOON_CONFIG" << EOF
# ZeroTier Moon Dynamic IP Configuration
ENABLED=1
ENDPOINT=$endpoint
PORT=$port
LAST_IP=
LAST_UPDATE=$(date +%s)
EOF
            echo "Dynamic IP monitoring enabled"
            echo "Endpoint: $endpoint:$port"

            # Auto-configure firewall
            configure_firewall add "$port"

            register_cron

            # Create initial moon
            update_moon_ip
            ;;

        "disable")
            if [ -f "$MOON_CONFIG" ]; then
                sed -i 's/ENABLED=1/ENABLED=0/' "$MOON_CONFIG"
                unregister_cron
                echo "Dynamic IP monitoring disabled"
            else
                echo "Not configured"
            fi
            ;;
            
        "status")
            if [ -f "$MOON_CONFIG" ]; then
                echo "=== Moon Dynamic IP Configuration ==="
                cat "$MOON_CONFIG"
                echo ""
                echo "=== Current Moon Status ==="
                list_moons 2>/dev/null || echo "ZeroTier not running"
            else
                echo "Dynamic IP not configured"
            fi
            ;;
            
        "update"|"check")
            update_moon_ip
            ;;
            
        *)
            echo "Usage: $0 dynamic {enable|disable|status|update} [endpoint] [port]"
            echo "  enable [domain/ip] [port] - Enable with domain or auto-detect IP"
            echo "  disable                   - Disable dynamic IP monitoring"
            echo "  status                    - Show configuration status"
            echo "  update                    - Force update moon with current IP"
            return 1
            ;;
    esac
}

# Update moon with current IP (called by cron, hotplug or manually)
update_moon_ip() {
    if [ ! -f "$MOON_CONFIG" ]; then
        echo "ERROR: Not configured. Run: $0 dynamic enable [endpoint] [port]"
        return 1
    fi

    # Values are read individually (conf_get), never sourced: a hostile
    # ENDPOINT line must not become executable shell.
    local enabled endpoint port last_ip
    enabled=$(conf_get ENABLED)
    endpoint=$(conf_get ENDPOINT)
    port=$(conf_get PORT)
    last_ip=$(conf_get LAST_IP)
    valid_port "$port" || port=9993

    if [ "$enabled" != "1" ]; then
        echo "Dynamic IP monitoring is disabled"
        return 0
    fi

    # Resolve endpoint (domain or IP or auto)
    local current_ip
    if [ "$endpoint" = "auto" ] || [ -z "$endpoint" ]; then
        current_ip=$(detect_public_ip)
    elif echo "$endpoint" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
        current_ip="$endpoint"
    else
        current_ip=$(resolve_domain "$endpoint")
    fi

    if ! echo "$current_ip" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
        echo "ERROR: Failed to resolve endpoint: $endpoint"
        return 1
    fi

    # Optional second endpoint: the WAN-side global IPv6.
    # MUST take it from the WAN (default-route) interface, not just the
    # first global v6 — a LAN bridge (br-lan) usually also carries a
    # delegated global prefix whose ::1 gateway address sorts first but
    # is NOT reachable from outside. Picking that silently broke the v6
    # endpoint. Also skip ::1-suffixed gateway-style addresses.
    local current_ip6 wan6dev
    wan6dev=$(ip -4 route show default 2>/dev/null | sed -n 's/.*dev \([^ ]*\).*/\1/p' | head -1)
    if [ -n "$wan6dev" ]; then
        current_ip6=$(ip -6 addr show dev "$wan6dev" scope global 2>/dev/null | \
            sed -n 's|.*inet6 \([0-9a-f:]*\)/.*|\1|p' | grep -v '^fd' | grep -v '::1$' | head -1)
    fi
    [ -z "$current_ip6" ] && current_ip6=$(ip -6 addr show scope global 2>/dev/null | \
        sed -n 's|.*inet6 \([0-9a-f:]*\)/.*|\1|p' | grep -v '^fd' | grep -v '::1$' | head -1)

    # Check if IP changed
    if [ "$current_ip" = "$last_ip" ]; then
        echo "IP unchanged: $current_ip"
        return 0
    fi

    echo "IP changed: ${last_ip:-<none>} -> $current_ip"
    echo "Updating moon configuration..."

    check_zerotier

    # Get node ID
    if [ ! -f "$ZT_HOME/identity.public" ]; then
        "$ZT_IDTOOL" getpublic "$ZT_HOME/identity.secret" > "$ZT_HOME/identity.public"
    fi
    local node_id=$(cat "$ZT_HOME/identity.public" | cut -d':' -f1)

    cd "$ZT_HOME" || return 1

    # CRITICAL: reuse the existing moon.json (it holds signingKey_SECRET).
    # Re-running initmoon would mint a NEW signing key; nodes that orbited
    # the old moon verify updates against updatesMustBeSignedBy and would
    # silently reject the re-signed world — the moon would never recover
    # for remote peers. Only endpoints may change; the key must not.
    if [ ! -s "$ZT_HOME/moon.json" ] || ! grep -q 'signingKey_SECRET' "$ZT_HOME/moon.json"; then
        echo "No reusable moon.json, initializing a fresh one..."
        "$ZT_IDTOOL" initmoon "$ZT_HOME/identity.public" > "$ZT_HOME/moon.json" 2>/dev/null
    fi

    local endpoints="\"${current_ip}/${port}\""
    [ -n "$current_ip6" ] && endpoints="$endpoints,\"${current_ip6}/${port}\""
    sed -i "s|\"stableEndpoints\": \[[^]]*\]|\"stableEndpoints\": [$endpoints]|" "$ZT_HOME/moon.json"

    # Remove only OUR OWN previous moon file. A bare 000000*.moon glob would
    # also delete the moons of other nodes we have orbited (they live in the
    # same directory), silently dropping us out of their moons on every
    # endpoint update.
    rm -f "$ZT_HOME/000000${node_id}.moon" "$ZT_HOME/moons.d/000000${node_id}.moon" 2>/dev/null

    if "$ZT_IDTOOL" genmoon "$ZT_HOME/moon.json"; then
        mkdir -p "$ZT_HOME/moons.d"

        # Move the moon genmoon just wrote (it lands in the current directory).
        # Match our own id explicitly rather than globbing, so a stray moon
        # file belonging to another node is never touched.
        moon_file="000000${node_id}.moon"
        if [ -f "$moon_file" ]; then
            mv "$moon_file" "$ZT_HOME/moons.d/"
            echo "Moved $moon_file to moons.d/"
        fi

        # Update config with new IP
        sed -i "s/LAST_IP=.*/LAST_IP=$current_ip/" "$MOON_CONFIG"
        sed -i "s/LAST_UPDATE=.*/LAST_UPDATE=$(date +%s)/" "$MOON_CONFIG"

        # Restart so the daemon loads the updated moon definition, then
        # push the new world revision out to connected peers.
        /etc/init.d/zerotier restart >/dev/null 2>&1
        logger -t zerotier-moon "Moon endpoint updated: $current_ip:$port (v6: ${current_ip6:-none})"

        echo "SUCCESS: Moon updated with IP $current_ip"
        [ -n "$current_ip6" ] && echo "IPv6 endpoint: $current_ip6"
        echo "Moon ID: $node_id"
    else
        echo "ERROR: Failed to generate moon"
        return 1
    fi
}

# Main function
case "$1" in
    "create")
        create_moon "$2" "$3"
        ;;
    "join")
        join_moon "$2"
        ;;
    "leave")
        leave_moon "$2"
        ;;
    "list")
        list_moons
        ;;
    "info")
        get_info
        ;;
    "dynamic")
        configure_dynamic "$2" "$3" "$4"
        ;;
    "update")
        update_moon_ip
        ;;
    "firewall")
        configure_firewall "$2" "$3"
        ;;
    *)
        echo "Usage: $0 {create|join|leave|list|info|dynamic|update|firewall}"
        echo ""
        echo "Commands:"
        echo "  create <ip/domain> [port]       - Create a moon node"
        echo "  join <moon_id>                  - Join a moon network"
        echo "  leave <moon_id>                 - Leave a moon network"
        echo "  list                            - List connected moons"
        echo "  info                            - Show node information"
        echo "  dynamic {enable|disable|status|update} [endpoint] [port]"
        echo "                                  - Configure dynamic IP/domain"
        echo "  update                          - Update moon with current IP"
        echo "  firewall {add|remove|status} [port]"
        echo "                                  - Manage firewall rules"
        exit 1
        ;;
esac