{
	"luci-app-zerotier": {
		"description": "Grant access to ZeroTier",
		"read": {
			"ubus": {
				"luci.zerotier": [
					"status", "peers", "permissions", "preview", "log", "probe",
					"ctlNetworks", "ctlNetwork", "moonStatus", "moonEndpoints", "hostnames"
				],
				"luci-rpc": [ "getHostHints", "getNetworkDevices" ]
			},
			"uci": [ "zerotier", "zerotier-phone-dns", "firewall", "network" ]
		},
		"write": {
			"ubus": {
				"luci.zerotier": [
					"ctlNetworkCreate", "ctlNetworkUpdate", "ctlNetworkDelete",
					"ctlMemberUpdate", "ctlMemberDelete", "moonAction"
				],
				"rc": [ "init" ]
			},
			"uci": [ "zerotier", "zerotier-phone-dns" ]
		}
	}
}
