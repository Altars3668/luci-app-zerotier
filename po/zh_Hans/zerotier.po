msgid "Accept DNS settings the controller pushes."
msgstr "接受控制器下发的 DNS 设置。"

#: htdocs/luci-static/resources/view/zerotier/settings.js:94
msgid "Accept managed addresses and routes that overlap public IP space."
msgstr "接受与公网地址段重叠的受管地址和路由。"

